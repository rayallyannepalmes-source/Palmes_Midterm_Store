@model List<Product>

<div class="d-flex justify-content-between align-items-center mb-3">

    <h2>Micah Bakes Products</h2>

    @if (ViewBag.FromCart != true)
    {
        <a asp-action="Create"
           class="btn btn-primary">
            + Add Product
        </a>

        
    }

</div>

<form asp-action="Index" method="get" class="mb-3">
    <input type="text" name="searchString" value="@ViewData["searchString"]"
           placeholder="Search product name..." />
    <button type="submit">Search</button>
    <a asp-action="Index">Clear</a>
</form>

<div class="row">

    @foreach (Product p in Model)
    {
        <div class="col-md-4 mb-4">

            <div class="card h-100 shadow-sm">

                <div class="card-body">

                    <h5 class="card-title">
                        @p.Name
                    </h5>

                    <h6 class="card-subtitle mb-2 text-muted">
                        @p.Category
                    </h6>

                    <p class="card-text">
                        @p.Description
                    </p>

                    <p class="fw-bold">
                        ₱@p.Price.ToString("N2")
                    </p>

                </div>

                <div class="card-footer">

                    <div class="d-flex gap-2">

                        <!-- Add to Cart always appears -->
                        <form asp-controller="Cart"
                              asp-action="Add"
                              method="post">

                            <input type="hidden"
                                   name="productId"
                                   value="@p.ID" />

                            <button type="submit"
                                    class="btn btn-success btn-sm">
                                Add to Cart
                            </button>

                        </form>

                        <!-- Edit and Delete only appear on normal Products page -->
                        @if (ViewBag.FromCart != true)
                        {
                            <a asp-action="Edit"
                               asp-route-id="@p.ID"
                               class="btn btn-warning btn-sm">
                                Edit
                            </a>

                            <form asp-action="Delete"
                                  asp-route-id="@p.ID"
                                  method="post">

                                <button type="submit"
                                        class="btn btn-danger btn-sm">
                                    Delete
                                </button>

                            </form>
                        }

                    </div>

                </div>

            </div>

        </div>
    }

</div>